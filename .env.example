# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Legacy projects may use the anon key instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY

# Never add a Supabase secret/service_role key to NEXT_PUBLIC_* variables.
# The application does not require a service-role key for normal user flows.
